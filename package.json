{
  "name": "hebergia",
  "version": "1.0.0",
  "private": true,
  "author": "ABDULKARIM",
  "description": "Gestion locale de l'hébergement universitaire",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "npm run build:renderer && electron .",
    "build:renderer": "vite build",
    "dist": "npm run build:renderer && electron-builder",
    "test": "node --test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "realm": "^20.2.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "com.hebergia.desktop",
    "productName": "Hebergia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/realm/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "include": "installer/custom.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "electron-winstaller@5.4.0": true,
    "realm@20.2.0": true
  }
}
